{
  "name": "sendless",
  "version": "1.6.0",
  "private": true,
  "description": "Serverless, self-hosted file transfer for AWS. Expiring links, password protection, file requests. Runs entirely in your own AWS account.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web",
    "ee"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:pro": "node scripts/dev.mjs --pro",
    "build": "npm run build -w @sendless/web && node scripts/build-backend.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:template": "cfn-lint template/sendless.yaml && python3 -I scripts/check-bootstrap.py",
    "e2e": "node scripts/e2e.mjs",
    "license:keygen": "tsx ee/tools/license-keygen.ts",
    "license:issue": "tsx ee/tools/license-issue.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@types/node": "^26.6.5",
    "amazon-cognito-identity-js": "^6.3.22",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
